# OpenRouter
# 화면에서 직접 입력해도 됩니다.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# 이메일 기본값
EMAIL_FROM=jongeunshin95@kbfg.com
EMAIL_TO=jongeunshin95@kbfg.com

# SMTP 설정
# 회사에서 사용하는 SMTP 서버 주소를 입력해야 실제 메일을 발송할 수 있습니다.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
